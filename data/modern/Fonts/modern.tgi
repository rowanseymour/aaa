;; The faces this project's own interface sets its text in, given as the
;; game gives its fonts.

[Font]
{
	ids = modern_stencil
	[CharacterSet]
	{
		ids = base
		font = /Fonts/TrueType/BigShouldersStencilDisplay-800.ttf
	}
}

[Font]
{
	ids = modern_plain
	[CharacterSet]
	{
		ids = base
		font = /Fonts/TrueType/BigShouldersText-600.ttf
	}
}

;; The interface over the map's, where text is small: compact like the plain
;; face, but drawn heavier and with figures and slashes that stay readable.
[Font]
{
	ids = modern_hud
	[CharacterSet]
	{
		ids = base
		font = /Fonts/TrueType/BarlowSemiCondensed-600.ttf
	}
}
